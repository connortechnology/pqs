function confirmDelete (e) {
	if ( ! confirm("Are you sure you want to delete?") ) {
		if (!e) { // For IE.
			event.returnValue = false;
		} else if(e.cancelable) { // For DOM
			e.stopPropagation();
			e.preventDefault();
		}
	}
}

