<? echo (
	my $User = new openprint::User( $param{contact_id} );
	my $html = '';
	$html .= "
		\$('vendor_contact').value = '$$User{firstname} $$User{lastname}';
		\$('vendor_phone').value = '$$User{phone}';
		\$('vendor_fax').value = '$$User{fax}';
		\$('vendor_email').value = '$$User{email}';
	";
	return $html;
) ?>
