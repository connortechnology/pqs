<? echo (
	my $Vendor = new openprint::Company( $param{supplier_id} );
	my $html = '';
	$html .= "
		\$('vendor_name').value = '$$Vendor{name}';
		\$('vendor_address1').value = '$$Vendor{address1}';
		\$('vendor_address2').value = '$$Vendor{address2}';
		\$('vendor_city').value = '$$Vendor{city}';
		ddm_select_by_value( \$('vendor_country'), '$$Vendor{country}' );
		ddm_select_by_value( \$('vendor_state'), '$$Vendor{state}' );
		\$('vendor_postalcode').value = '$$Vendor{postalcode}';
		\$('vendor_phone').value = '$$Vendor{phone}';
		\$('vendor_fax').value = '$$Vendor{fax}';
		var contact_ddm = \$('contact_id');
		clear_ddm( contact_ddm );
		add_option( contact_ddm, '', 'select' );
	";
	my @Users = openprint::User->find( company_id=>$param{supplier_id} ) if $$Vendor{id};
	my $selected = $Users[0]->id() if @Users == 1;
	foreach my $User ( @Users ) {
		my $name = $User->name();
		$name =~ s/'/\\'/g;
		$html .= "add_option( contact_ddm, '$$User{id}', '$name', '$selected' );\n";
	} # end foreach User
	if ( @Users == 1 ) {
		my $User= $Users[0];
		$html .= "
			\$('vendor_contact').value = '$$User{firstname} $$User{lastname}';
			\$('vendor_phone').value = '$$User{phone}';
			\$('vendor_fax').value = '$$User{fax}';
			\$('vendor_email').value = '$$User{email}';
		";
	} # end if
	$html .= q`
		$('contacts').show();
		if ( po_id ) 
			update_taxes( contact_ddm.form );
	`;
	return $html;
) ?>
