	foreach my $id ( sort @drops ) {
		$html .= sprintf(q`new Ajax.Updater('%1$s_div', '_ul_div.html', { parameters: { ul_id: '%1$s' }, evalScripts:true });`, $id);
	} # end foreach id
$log->debug($html);
	return $html;
) ?>
	drops.push("<? echo ( join('","', @{$$variable{'changed'}} ) ) ?>");
	setup_drops();
<? endif ( $$variable{changed} ) ?>
