var new_shifts = 0;
<? echo ( 
	my @drops = sets::union( @{$$variable{'changed'}} );
	my $html = '';
	$html .= "alert('$variable{error}');" if $variable{'error'};
	$html .= "alert('$variable{alert}');" if $variable{'alert'};
	foreach my $id ( sort @drops ) {
		$html .= sprintf(q`if ( $('%1$s') ){new Ajax.Updater( '%1$s', '_ul.html', { parameters: { ul_id: '%1$s' }, evalScripts: true } );} else {new_shifts=1;}`, $id );
	} # end foreach id
	return $html;
) ?>
if ( new_shifts ) {
	alert('Shifts have been changed that are not currently visible.');
}
