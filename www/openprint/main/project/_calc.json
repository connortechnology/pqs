<? echo (
	my $debug = 0;

my %specs;
eval {
	%specs = openprint::main_project::calc( $debug );
  if ($debug or 1) {
    use Data::Dumper;
    $log->debug('Specs after calc'.Dumper(\%specs));
  }
};
if ($@) {
  $specs{Status} = 'uncalculated';
$specs{alert} = 'Calculation has crashed. Please contact the developer.<br/>'.$@;
$log->error($@);
}

	$param{callback} = 'cbFillResults' if ! $param{callback};
	my $json = JSON->new;
  $log->debug($json->encode( \%specs )) if $debug;
	return $json->encode( \%specs );
) ?>
